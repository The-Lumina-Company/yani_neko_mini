Dialogue: 0,0:00:00.95,0:00:02.61,SP-Custom,,0,0,0,,Başlıyorum, Senpai.
Dialogue: 0,0:00:02.75,0:00:03.49,SP-Custom,,0,0,0,,Gönderiyav.
Dialogue: 0,0:00:08.78,0:00:10.67,SP-Custom,,0,0,0,,{\an8}Dün, ben...
Dialogue: 0,0:00:11.08,0:00:15.68,SP-Custom,,0,0,0,,{\an8}...aji ve salatalıklı bi' yemek yedim.
Dialogue: 0,0:00:16.50,0:00:20.87,SP-Custom,,0,0,0,,{\an8}Senpai, sen yemekte ne yedin?
Dialogue: 0,0:00:21.35,0:00:23.45,SP-Custom,,0,0,0,,Harbiden duyuyorum lan seniyav!
Dialogue: 0,0:00:23.45,0:00:26.15,SP-Custom,,0,0,0,,Valla mı? E müthiş bir şey bu!
Dialogue: 0,0:00:26.51,0:00:28.74,SP-Custom,,0,0,0,,Senpai, sen de bir şeyler söylemeyi denemelisin.
Dialogue: 0,0:00:28.82,0:00:30.33,SP-Custom,,0,0,0,,Bende o işiyav.
Dialogue: 0,0:00:34.59,0:00:38.42,SP-Custom,,0,0,0,,{\an8}Dün Jiro tarzı bir yemekti,
Dialogue: 0,0:00:39.33,0:00:42.62,SP-Custom,,0,0,0,,{\an8}yani büyük porsiyon ve ek olarak yiyebildiğim kadar
Dialogue: 0,0:00:43.38,0:00:44.85,SP-Custom,,0,0,0,,{\an8}sarımsak yedimiyav.
Dialogue: 0,0:00:47.90,0:00:50.27,SP-Custom,,0,0,0,,{\an8}Güzel miydi bari?
Dialogue: 0,0:00:50.65,0:00:52.09,SP-Custom,,0,0,0,,{\an8}Yaaniyav.
Dialogue: 0,0:00:52.66,0:00:56.70,SP-Custom,,0,0,0,,{\an8}Fakat porsiyonları azıcık büyük olduğundan birazını paket yaptırmak zorunda kaldımiyav.
Dialogue: 0,0:00:57.34,0:01:01.40,SP-Custom,,0,0,0,,{\an8}Sonra gece yarısında birden inanılmaz acıktımiyav
Dialogue: 0,0:01:02.26,0:01:06.83,SP-Custom,,0,0,0,,{\an8}ve bir sürü muzum olduğundan onları yedimiyav.
Dialogue: 0,0:01:09.85,0:01:12.73,SP-Custom,,0,0,0,,{\an8}Ardından sütlü kahveden sonra\N sigara içmeye gittiğimde,
Dialogue: 0,0:01:12.97,0:01:15.98,SP-Custom,,0,0,0,,{\an8}aşırı uykum geldiyav.
Dialogue: 0,0:01:16.77,0:01:20.45,SP-Custom,,0,0,0,,{\an8}Öyle bi' uyumuşum ki sanki ölmüşüm gibiyav.
Dialogue: 0,0:01:21.64,0:01:25.19,SP-Custom,,0,0,0,,{\an8}Uyandığımda ağzım yapış yapıştıyav.
Dialogue: 0,0:01:25.59,0:01:27.25,SP-Custom,,0,0,0,,{\an8}Gözünü açar açmaz sek kahveyle
Dialogue: 0,0:01:27.25,0:01:30.19,SP-Custom,,0,0,0,,{\an8}mentollüyü gömeceksin,
Dialogue: 0,0:01:30.37,0:01:33.63,SP-Custom,,0,0,0,,{\an8}üstüne tanımam.
Dialogue: 0,0:01:41.84,0:01:43.27,SP-Custom (Signs),,0,0,0,,{\fnBrush Script MT\fs200\c&H00A6F9&\bord0\shad0\b0\fscx25\fscy25\pos(1064,576.8)}Müptezel Kedi
